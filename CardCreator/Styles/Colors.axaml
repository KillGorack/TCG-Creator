<!--
    Dave-Standard tokens for Avalonia (v0.1). Same keys and values as c#_WPF/Styles/Colors.*.xaml and
    python_customtkinter/dave_theme.py. Dark and Light live in ThemeDictionaries, so {DynamicResource XxxBrush}
    follows Application.RequestedThemeVariant (ThemeManager.Apply). The Fluent keys below the tokens remove the
    system accent: every selected / focused / pressed state is a neutral gray, as in the other stacks.
    Generated once from the WPF files; keep the three stacks in step by hand.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="WindowBrush" Color="#262626" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#171717" />
            <SolidColorBrush x:Key="TextBrush" Color="#B1B1B1" />
            <SolidColorBrush x:Key="TextStrongBrush" Color="#D4D4D4" />
            <SolidColorBrush x:Key="MutedBrush" Color="#8F8F8F" />
            <SolidColorBrush x:Key="BubbleBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="BubbleTextBrush" Color="#B1B1B1" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#A3B88A" />
            <SolidColorBrush x:Key="LinkBrush" Color="#8AB4F8" />
            <SolidColorBrush x:Key="RuleBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="ButtonBrush" Color="#525252" />
            <SolidColorBrush x:Key="ButtonHoverBrush" Color="#737373" />
            <SolidColorBrush x:Key="HoverBrush" Color="#333333" />
            <SolidColorBrush x:Key="ScrollbarBrush" Color="#404040" />
            <SolidColorBrush x:Key="ScrollbarHoverBrush" Color="#525252" />
            <SolidColorBrush x:Key="CodeBgBrush" Color="#262626" />
            <SolidColorBrush x:Key="CodeHeadBrush" Color="#9A9A9A" />
            <SolidColorBrush x:Key="CodeHeadBgBrush" Color="#333333" />
            <SolidColorBrush x:Key="SynKeywordBrush" Color="#C09BC8" />
            <SolidColorBrush x:Key="SynStringBrush" Color="#A3B88A" />
            <SolidColorBrush x:Key="SynCommentBrush" Color="#767676" />
            <SolidColorBrush x:Key="SynNumberBrush" Color="#D1A173" />
            <SolidColorBrush x:Key="SynBuiltinBrush" Color="#80B3AD" />
            <SolidColorBrush x:Key="SynFuncBrush" Color="#8EAED4" />
            <Color x:Key="SystemAccentColor">#525252</Color>
            <Color x:Key="SystemAccentColorDark1">#525252</Color>
            <Color x:Key="SystemAccentColorDark2">#525252</Color>
            <Color x:Key="SystemAccentColorDark3">#525252</Color>
            <Color x:Key="SystemAccentColorLight1">#525252</Color>
            <Color x:Key="SystemAccentColorLight2">#525252</Color>
            <Color x:Key="SystemAccentColorLight3">#525252</Color>

            <StaticResource x:Key="TextControlBackground" ResourceKey="HoverBrush" />
            <StaticResource x:Key="TextControlBackgroundPointerOver" ResourceKey="HoverBrush" />
            <StaticResource x:Key="TextControlBackgroundFocused" ResourceKey="HoverBrush" />
            <StaticResource x:Key="TextControlBackgroundDisabled" ResourceKey="HoverBrush" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
            <StaticResource x:Key="TextControlForeground" ResourceKey="TextBrush" />
            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextBrush" />
            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextBrush" />
            <StaticResource x:Key="TextControlForegroundDisabled" ResourceKey="MutedBrush" />
            <StaticResource x:Key="TextControlPlaceholderForeground" ResourceKey="MutedBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundPointerOver" ResourceKey="MutedBrush" />
            <StaticResource x:Key="TextControlPlaceholderForegroundFocused" ResourceKey="MutedBrush" />
            <x:Double x:Key="TextControlPlaceholderOpacity">1</x:Double>
            <StaticResource x:Key="ButtonBackground" ResourceKey="ButtonBrush" />
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="ButtonHoverBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="ButtonHoverBrush" />
            <StaticResource x:Key="ButtonBackgroundDisabled" ResourceKey="HoverBrush" />
            <StaticResource x:Key="ButtonForeground" ResourceKey="TextBrush" />
            <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="TextBrush" />
            <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="TextBrush" />
            <StaticResource x:Key="ButtonForegroundDisabled" ResourceKey="MutedBrush" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            <StaticResource x:Key="ComboBoxBackground" ResourceKey="HoverBrush" />
            <StaticResource x:Key="ComboBoxBackgroundUnfocused" ResourceKey="HoverBrush" />
            <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="ScrollbarBrush" />
            <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="ScrollbarBrush" />
            <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="HoverBrush" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="Transparent" />
            <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushUnfocused" Color="Transparent" />
            <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextBrush" />
            <StaticResource x:Key="ComboBoxForegroundPointerOver" ResourceKey="TextBrush" />
            <StaticResource x:Key="ComboBoxForegroundPressed" ResourceKey="TextBrush" />
            <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SurfaceBrush" />
            <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="RuleBrush" />
            <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="MutedBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="HoverBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundPressed" ResourceKey="HoverBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="HoverBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="HoverBrush" />
            <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="HoverBrush" />
            <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="TextBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundPressed" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="ComboBoxItemForegroundSelectedPressed" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="ToolTipBackground" ResourceKey="SurfaceBrush" />
            <StaticResource x:Key="ToolTipBorderBrush" ResourceKey="RuleBrush" />
            <StaticResource x:Key="ToolTipForeground" ResourceKey="TextBrush" />
            <StaticResource x:Key="ScrollBarThumbFill" ResourceKey="ScrollbarBrush" />
            <StaticResource x:Key="ScrollBarThumbFillPointerOver" ResourceKey="ScrollbarHoverBrush" />
            <StaticResource x:Key="ScrollBarThumbFillPressed" ResourceKey="ScrollbarHoverBrush" />
            <SolidColorBrush x:Key="ScrollBarTrackFill" Color="Transparent" />
            <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="Transparent" />
            <StaticResource x:Key="CalendarViewBackground" ResourceKey="SurfaceBrush" />
