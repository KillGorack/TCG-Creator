            <StaticResource x:Key="CalendarViewCalendarItemForeground" ResourceKey="TextBrush" />
            <StaticResource x:Key="CalendarViewOutOfScopeForeground" ResourceKey="MutedBrush" />
            <StaticResource x:Key="CalendarViewTodayForeground" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="CalendarViewNavigationButtonForegroundPointerOver" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="CalendarViewNavigationButtonForegroundPressed" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillChecked" ResourceKey="ButtonBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" ResourceKey="ButtonHoverBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="ButtonHoverBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="ButtonBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="ButtonHoverBrush" />
            <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="ButtonHoverBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="SystemControlHighlightAccentBrush" ResourceKey="ButtonBrush" />
            <StaticResource x:Key="SystemControlForegroundAccentBrush" ResourceKey="TextStrongBrush" />
            <StaticResource x:Key="SystemControlBackgroundAccentBrush" ResourceKey="ButtonBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
