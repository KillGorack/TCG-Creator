<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CardCreator.ViewModels"
        xmlns:ui="using:CardCreator.Theme"
        x:Class="CardCreator.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/icon.png"
        Width="1180" Height="780" MinWidth="980" MinHeight="600"
        Title="CardCreator">

    <Grid Margin="10" RowDefinitions="*,Auto" RowSpacing="10">

        <Grid ColumnDefinitions="250,*,300" ColumnSpacing="10">

            <!-- Your cards: + starts a new one, the trash can on a row deletes it -->
            <ui:Section x:Name="CardsSection" Title="Cards" ShowAdd="True" AddTip="New card (Ctrl+N)">
                <ui:DataTable x:Name="CardsTable" ShowHeader="False" EmptyText="No cards yet. Use + to make one." />
            </ui:Section>

            <!-- Live preview: the card at its print size (1500 x 2100), scaled to fit -->
            <Border Grid.Column="1" Classes="panel" Padding="10">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas x:Name="CardCanvas" Width="1500" Height="2100">

                        <Rectangle Width="1500" Height="2100" Fill="{Binding BgBrush}" />

                        <Canvas Canvas.Left="100" Canvas.Top="135" Width="1300" Height="1200" ClipToBounds="True">
                            <Image Source="{Binding Art}" Width="1300" Height="1200" Stretch="UniformToFill" />
                        </Canvas>

                        <Image Source="{Binding BaseFrame}" Width="1500" Height="2100" />

                        <!-- The seven text zones, all drawn from one list (ZoneViewModel) -->
                        <ItemsControl ItemsSource="{Binding Zones}" Width="1500" Height="2100">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <Style Selector="ContentPresenter" x:DataType="vm:ZoneViewModel">
                                    <Setter Property="Canvas.Left" Value="{Binding FrameX}" />
                                    <Setter Property="Canvas.Top" Value="{Binding FrameY}" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ZoneViewModel">
                                    <Panel Width="{Binding FrameW}" Height="{Binding FrameH}" IsVisible="{Binding HasText}">
                                        <Image Source="{Binding Frame}" Stretch="Fill" />
                                        <!-- long text shrinks to fit its box instead of spilling out; short text stays centered -->
                                        <Panel Width="{Binding TextW}" Height="{Binding TextH}" Margin="{Binding TextMargin}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Viewbox MaxWidth="{Binding TextW}" MaxHeight="{Binding TextH}" StretchDirection="DownOnly"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Text}" Foreground="White" FontSize="{Binding FontSize}"
                                                           FontWeight="Bold" TextAlignment="Center" />
                                            </Viewbox>
                                        </Panel>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Canvas.Left="95" Canvas.Top="1344" Width="1313" Height="663" Padding="20">
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="{Binding BodyText}" Width="1273" TextWrapping="Wrap" Foreground="#222222"
                                           FontSize="52" FontWeight="Bold"
                                           FontFamily="avares://CardCreator/Assets/Fonts#Liberation Serif" />
                            </Viewbox>
                        </Border>
                    </Canvas>
                </Viewbox>
            </Border>

            <!-- The card's text -->
            <ui:Section Grid.Column="2" Title="Card">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="0,0,6,0">
                        <ItemsControl ItemsSource="{Binding Zones}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ZoneViewModel">
                                    <StackPanel Spacing="4" Margin="0,0,0,6">
                                        <TextBlock Classes="note" Text="{Binding Label}" />
                                        <TextBox Text="{Binding Text}" />
                                        <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error.Length}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="4">
                            <TextBlock Classes="note" Text="Card text" />
                            <TextBox Classes="area" Height="96" Text="{Binding BodyText}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="note" Text="Background color (#RRGGBB)" />
                            <TextBox Text="{Binding BgColor}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="note" Text="Frame color" />
                            <ComboBox ItemsSource="{Binding FrameColors}" SelectedItem="{Binding FrameColor}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </ui:Section>
        </Grid>

        <!-- Toolbar: save, art, export | status | theme -->
        <Border Grid.Row="1" Classes="panel" Padding="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Border Classes="divider" />
                    <Button x:Name="ThemeBtn" Classes="icon" Tag="sun" ToolTip.Tip="Light theme" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="SaveBtn" Classes="icon" Tag="save" ToolTip.Tip="Save card (Ctrl+S)" />
                    <Button x:Name="ArtBtn" Classes="icon" Tag="image" ToolTip.Tip="Choose the card's art" />
                    <Button x:Name="ExportBtn" Classes="icon" Tag="file-down" ToolTip.Tip="Export as a print-ready PNG (Ctrl+E)" />
                    <Button x:Name="ExportAllBtn" Classes="icon" Tag="folder-down" ToolTip.Tip="Export every card to a folder (Ctrl+Shift+E)" />
                    <Button x:Name="PrintBtn" Classes="icon" Tag="printer" ToolTip.Tip="Print sheets: lay cards out on paper as a PDF (Ctrl+P)" />
                </StackPanel>
                <TextBlock x:Name="NoteText" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
